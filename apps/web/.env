# Public, non-secret site configuration, shared by every environment.
# NEXT_PUBLIC_* values are baked into the static export at build time and are
# visible on the website, so never put secrets here. Override locally in
# .env.local (git-ignored) or in your hosting provider's settings.

# The Rooffur WhatsApp group invite — every WhatsApp CTA uses it.
NEXT_PUBLIC_ROOFFUR_WHATSAPP_URL=https://chat.whatsapp.com/JuNCTQgHaUnLwkVIJ3LrLl

# Rooffur admin contact addresses (comma-separated), shown under Contact in
# the footer. Same addresses as in the Terms and Privacy & Safety Policy.
NEXT_PUBLIC_ROOFFUR_CONTACT_EMAILS=nischalsrinivas011@gmail.com,ranjithagowda1024@gmail.com
