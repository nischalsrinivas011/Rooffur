# Copy to apps/web/.env.local for development, and set the same variables in
# your hosting provider for production builds. NEXT_PUBLIC_* values are baked
# into the static export at build time.

# Canonical site origin (canonical URL, Open Graph, sitemap). Defaults to https://rooffur.com.
NEXT_PUBLIC_SITE_URL=https://rooffur.com

# The Rooffur WhatsApp Community/Group invite. Every WhatsApp CTA uses this one URL.
# Must be an https link on chat.whatsapp.com, wa.me or whatsapp.com.
# If missing or invalid, WhatsApp CTAs render disabled (and dev shows a warning).
NEXT_PUBLIC_ROOFFUR_WHATSAPP_URL=

# Admin contact addresses (comma-separated), listed under Contact in the footer.
# If missing, the footer shows "Contact details coming soon" — never an invented address.
NEXT_PUBLIC_ROOFFUR_CONTACT_EMAILS=

# Official social accounts. Leave blank until real profiles exist; blank ones are not shown.
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
